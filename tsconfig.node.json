{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "src/types/model.ts",
    "src/domain/index.ts",
    "src/domain/auth.ts",
    "src/domain/legalEntity.ts",
    "src/domain/leaveType.ts",
    "src/domain/entitlementUsage.ts",
    "src/domain/leaveEntitlement.ts",
    "src/domain/leaveRequest.ts",
    "src/domain/team.ts",
    "src/domain/employee.ts",
    "src/api/openapi.ts",
    "src/data/demoLeaveRequests.ts",
    "src/server/mariadbClient.ts",
    "src/server/sessionRepository.ts",
    "src/server/authApi.ts",
    "src/server/teamRepository.ts",
    "src/server/teamApi.ts",
    "src/server/employeeRepository.ts",
    "src/server/employeeApi.ts",
    "src/server/leaveEntitlementRepository.ts",
    "src/server/leaveEntitlementApi.ts",
    "src/server/leaveRequestRepository.ts",
    "src/server/leaveRequestApi.ts"
  ]
}
