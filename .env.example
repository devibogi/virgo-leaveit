# Copy to .env (gitignored) and set local values. Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leaveit
DB_USER=leaveit
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Auth: demo = role switcher (prototype only), ldap = company LDAP sign-in
AUTH_MODE=demo
LDAP_URL=ldaps://ldap.example.invalid:636
LDAP_BASE_DN=ou=people,dc=example,dc=invalid
LDAP_LOGIN_ATTRIBUTE=uid
# Optional service account for user lookup; leave empty for direct bind
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
SESSION_SECRET=change-me-long-random
